#!/bin/sh
# Stand-in for /usr/bin/security used by the test suite, so nothing ever
# touches the real Keychain. Items are files under $FAKE_KEYCHAIN_DIR.
set -eu
: "${FAKE_KEYCHAIN_DIR:?FAKE_KEYCHAIN_DIR must be set}"
mkdir -p "$FAKE_KEYCHAIN_DIR"

cmd=${1:-}; shift || true
acct=''; svc=''; want_pw=0
while [ $# -gt 0 ]; do
  case $1 in
    -a) acct=$2; shift 2 ;;
    -s) svc=$2; shift 2 ;;
    -w) want_pw=1; shift ;;
    -U) shift ;;
    *) shift ;;
  esac
done
item=$FAKE_KEYCHAIN_DIR/$acct.$svc

case $cmd in
  add-generic-password)
    cat > "$item"
    echo "fake-security: stored $svc" >> "$FAKE_KEYCHAIN_DIR/.log" ;;
  find-generic-password)
    [ -f "$item" ] || { echo "security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain." >&2; exit 44; }
    if [ "$want_pw" = 1 ]; then cat "$item"; else printf 'keychain: "fake"\n    "acct"<blob>="%s"\n    "svc"<blob>="%s"\n' "$acct" "$svc"; fi ;;
  delete-generic-password)
    [ -f "$item" ] || { echo "security: could not be found" >&2; exit 44; }
    rm -f "$item" ;;
  *) echo "fake-security: unsupported command '$cmd'" >&2; exit 2 ;;
esac
