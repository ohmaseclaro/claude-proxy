#!/bin/sh
# Stand-in for the real `claude`.
#
# Plain invocations echo how they were called, so the wrapper's argument
# pass-through can be asserted. A stream-json invocation instead plays the
# scenario its token names, so `list --probe` can be tested end to end.
case " $* " in
  *" stream-json "*)
    case ${CLAUDE_CODE_OAUTH_TOKEN-} in
      tok-scope-ok)
        echo '{"type":"system","subtype":"init","session_id":"s1"}'
        echo '{"type":"rate_limit_event","rate_limit_info":{"status":"allowed","resetsAt":RESET5,"rateLimitType":"five_hour","overageStatus":"rejected","overageDisabledReason":"out_of_credits","isUsingOverage":false,"unifiedWindows":{"five_hour":{"utilization":0.04,"resetsAt":RESET5},"seven_day":{"utilization":0.1,"resetsAt":RESET7}}}}'
        exec sleep 30 ;;
      tok-scope-noevent)
        echo '{"type":"system","subtype":"init","session_id":"s1"}'
        exit 0 ;;
      tok-scope-bad)
        echo '{"type":"rate_limit_event","rate_limit_info":{"unifiedWindows"'
        exit 0 ;;
      tok-scope-fail)
        echo "Failed to authenticate. API Error: 401 Invalid bearer token" >&2
        exit 1 ;;
      tok-scope-hang) exec sleep 30 ;;
      *) echo "unscripted token" >&2; exit 2 ;;
    esac ;;
esac
echo "claude-args: $*"
echo "claude-argc: $#"
echo "oauth-token: ${CLAUDE_CODE_OAUTH_TOKEN-<unset>}"
echo "api-key: ${ANTHROPIC_API_KEY-<unset>}"
echo "auth-token: ${ANTHROPIC_AUTH_TOKEN-<unset>}"
